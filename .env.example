# Copiá este archivo a .env.local y completá los valores. .env.local no se commitea.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers).
# Formato: mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/ (también vale mongodb://).
MONGODB_URI=

# Base de datos: paperfolio-dev para desarrollo, paperfolio para producción.
MONGODB_DB=paperfolio-dev

# Sal del hash SHA-256 de la IP de quien consulta (antispam: 5 consultas por hora por IP).
# Mínimo 16 caracteres, al azar: por ejemplo `openssl rand -hex 32`. No la cambies en producción
# sin saber que se pierde el conteo de la última hora.
IP_HASH_SAL=
