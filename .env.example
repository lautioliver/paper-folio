# Copiá este archivo a .env.local y completá los valores. .env.local no se commitea.

# Cadena de conexión de MongoDB Atlas (Connect > Drivers).
# Formato: mongodb+srv://<usuario>:<clave>@<cluster>.mongodb.net/ (también vale mongodb://).
MONGODB_URI=

# Base de datos: paperfolio-dev para desarrollo, paperfolio para producción.
MONGODB_DB=paperfolio-dev

# Sal del hash SHA-256 de la IP de quien consulta (antispam: 5 consultas por hora por IP).
# Mínimo 16 caracteres, al azar: por ejemplo `openssl rand -hex 32`. No la cambies en producción
# sin saber que se pierde el conteo de la última hora.
IP_HASH_SAL=

# Clave de la API de Resend para avisar cada consulta nueva por email (empieza con re_).
# Se saca en https://resend.com/api-keys (Create API Key, con permiso de envío).
RESEND_API_KEY=

# Email que recibe el aviso de cada consulta nueva. Con el remitente de pruebas
# onboarding@resend.dev, Resend solo entrega al email con el que se creó la cuenta.
CONTACTO_EMAIL_DESTINO=

# Auth.js (ADR-002). Clave de las sesiones: al menos 32 caracteres (`openssl rand -base64 32`), una por entorno.
AUTH_SECRET=

# Cliente OAuth de Google (docs/development/setup.md, "Ingreso con Google").
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# Emails separados por comas que son admin siempre (los demás roles se asignan en /panel/usuarios). Nunca en el repo.
ADMIN_EMAILS=

# Vercel Blob (imágenes del contenido): id del store, empieza con store_. La autenticación es por OIDC:
# en Vercel, VERCEL_OIDC_TOKEN lo inyecta la plataforma; en local va también acá (vence a las ~12 h,
# ver docs/development/setup.md, "Imágenes en Vercel Blob").
BLOB_STORE_ID=

# Gmail por SMTP para responder las consultas desde el panel (docs/development/setup.md, "Respuestas por Gmail").
# GMAIL_USER es la cuenta que envía; GMAIL_APP_PASSWORD, una contraseña de aplicación de esa cuenta
# (16 caracteres, necesita la verificación en dos pasos). Nunca la contraseña normal de la cuenta.
GMAIL_USER=
GMAIL_APP_PASSWORD=
